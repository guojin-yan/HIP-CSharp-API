{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HipSharp runtime package manifest",
  "type": "object",
  "required": ["schemaVersion", "packageId", "packageVersion", "rid", "packEnabled", "verified", "nativeAssetPath", "source", "packages", "files", "licenses", "dependencyClosure", "systemDependencies", "driverBoundary", "sbom", "verification"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packageId": { "pattern": "^JYPPX\\.ROCm\\.HIP\\.CSharp\\.API\\.Runtime\\.(linux|win)-x64$" },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "rid": { "enum": ["linux-x64", "win-x64"] },
    "packEnabled": { "type": "boolean" },
    "verified": { "type": "boolean" },
    "nativeAssetPath": { "type": "string", "pattern": "^runtimes/(linux|win)-x64/native$" },
    "source": { "type": "object" },
    "packages": { "type": "array", "minItems": 1 },
    "files": { "type": "array" },
    "licenses": { "type": "array" },
    "dependencyClosure": { "type": "object" },
    "systemDependencies": { "type": "array" },
    "driverBoundary": { "type": "object" },
    "sbom": { "type": "object" },
    "verification": {
      "type": "object",
      "properties": {
        "promotionReceipt": {
          "type": "object",
          "required": ["path", "sha256", "lockPath"],
          "properties": {
            "path": { "const": "nuget/runtime-manifests/linux-x64.promotion-receipt.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "lockPath": { "const": "eng/promotion/m8.7-promotion-lock.json" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": true
}
