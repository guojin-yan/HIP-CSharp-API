<Project>
  <Import Project="..\Directory.Build.props" />
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(MSBuildProjectName)\</BaseOutputPath>
    <NuGetLockFilePath>$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageIcon>logo.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Description>AMD ROCm user-mode runtime assets for JYPPX.ROCm.HipSharp. Package generation is guarded by signed provenance, dependency closure, licenses, SBOM, package audit, and isolated GPU validation.</Description>
    <PackageTags>AMD;HIP;ROCm;runtime;native</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\nuget\logo.jpg" Pack="true" PackagePath="\" Link="logo.jpg" />
    <None Include="..\nuget\runtime\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\nuget\promotion\m8.9\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>
</Project>
