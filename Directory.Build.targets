<Project>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ValidateLibraryTargetFrameworks"
          BeforeTargets="PrepareForBuild"
          Condition="'$(IsHipSharpCoreProject)' == 'true' and '$(TargetFrameworks)' != '$(JYPPXManagedTargetFrameworks)'">
    <Error Text="Core projects must target the complete JYPPXManagedTargetFrameworks matrix." />
  </Target>
</Project>
