nuget/runtime-manifests/linux-x64.cdx.json text eol=crlf
nuget/runtime-manifests/linux-x64.dependency-closure.json text eol=crlf
nuget/runtime-manifests/linux-x64.licenses.json text eol=crlf
nuget/runtime-manifests/linux-x64.provenance.json text eol=crlf
nuget/runtime-manifests/linux-x64.sizes.json text eol=crlf
