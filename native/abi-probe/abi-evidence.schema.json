{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/HIP-CSharp-API/native/abi-probe/abi-evidence.schema.json",
  "title": "HipSharp ABI evidence",
  "type": "object",
  "required": [ "schemaVersion", "gitCommit", "normalizedManifestHash", "environment", "compiler", "headers", "libraries", "types", "functions" ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "normalizedManifestHash": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "environment": {
      "type": "object",
      "required": [ "os", "architecture", "rocmVersion", "hipVersion" ],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "rocmVersion": { "type": "string" },
        "hipVersion": { "type": "string" }
      }
    },
    "headers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [ "path", "sha256" ],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
        }
      }
    },
    "libraries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [ "name", "path", "symbols" ],
        "properties": {
          "name": { "enum": [ "amdhip64", "hiprtc" ] },
          "path": { "type": "string" },
          "symbols": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "types": { "type": "array", "minItems": 20, "items": { "type": "object" } },
    "compiler": { "type": "object" },
    "functions": { "type": "array", "minItems": 68, "items": { "type": "object" } },
    "offsets": { "type": "object" }
  }
}
