{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/HIP-CSharp-API/native/abi-probe/abi-evidence.schema.json",
  "title": "HipSharp ABI evidence",
  "type": "object",
  "required": [ "gitCommit", "environment", "header", "symbols", "types" ],
  "properties": {
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": {
      "type": "object",
      "required": [ "os", "architecture", "rocmVersion", "hipVersion" ],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "rocmVersion": { "type": "string" },
        "hipVersion": { "type": "string" }
      }
    },
    "header": {
      "type": "object",
      "required": [ "path", "sha256" ],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
      }
    },
    "symbols": { "type": "array", "items": { "type": "string" } },
    "types": { "type": "array", "items": { "type": "object" } }
  }
}
