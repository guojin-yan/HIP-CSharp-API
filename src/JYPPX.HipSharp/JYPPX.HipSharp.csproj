<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(JYPPXManagedTargetFrameworks)</TargetFrameworks>
    <AssemblyName>JYPPX.HipSharp</AssemblyName>
    <RootNamespace>JYPPX.HipSharp</RootNamespace>
    <IsHipSharpCoreProject>true</IsHipSharpCoreProject>

    <IsPackable>true</IsPackable>
    <PackageId>JYPPX.HIP.CSharp.API</PackageId>
    <Title>JYPPX HIP C# API</Title>
    <Description>Engineering baseline for direct HIP C ABI bindings across .NET Framework 4.6 through .NET 10. HIP API calls are not implemented in M0.</Description>
    <PackageTags>AMD;HIP;ROCm;GPU;interop;CSharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.jpg</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- This dependency-free package intentionally has lib groups without nuspec dependency groups.
         Package tests enforce the exact 15-TFM asset matrix, so suppress only this NuGet heuristic. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\nuget\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\nuget\logo.jpg" Pack="true" PackagePath="\" Link="logo.jpg" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

</Project>
