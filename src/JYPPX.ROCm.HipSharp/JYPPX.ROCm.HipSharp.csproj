<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(JYPPXManagedTargetFrameworks)</TargetFrameworks>
    <AssemblyName>JYPPX.ROCm.HIP.CSharp.API</AssemblyName>
    <RootNamespace>JYPPX.ROCm.HipSharp</RootNamespace>
    <IsHipSharpCoreProject>true</IsHipSharpCoreProject>

    <IsPackable>true</IsPackable>
    <PackageId>JYPPX.ROCm.HIP.CSharp.API</PackageId>
    <Title>JYPPX HIP C# API</Title>
    <Description>Direct HIP Runtime and HIPRTC C ABI bindings with managed device, memory, runtime compilation, module, and kernel APIs across .NET Framework 4.6 through .NET 10.</Description>
    <PackageTags>AMD;HIP;ROCm;GPU;interop;CSharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.jpg</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
    <PackageReleaseNotes>Core 0.9.2 interface-ledger validation batch with the 0.9.1 public API unchanged. Candidate bytes are unpublished, publishable=false, and releaseAuthorized=false.</PackageReleaseNotes>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- This dependency-free package intentionally has lib groups without nuspec dependency groups.
         Package tests enforce the exact 15-TFM asset matrix, so suppress only this NuGet heuristic. -->
    <!-- ThrowIf* helpers do not exist on the oldest supported target frameworks. -->
    <NoWarn>$(NoWarn);NU5128;CA1510;CA1512;CA1513;IDE0011;CA1711;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\nuget\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\nuget\logo.jpg" Pack="true" PackagePath="\" Link="logo.jpg" />
    <None Include="..\..\nuget\promotion\m8.9\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

</Project>
